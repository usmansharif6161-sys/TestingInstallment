EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Device Provisioning QR — APK hosted on Supabase Storage
# Auto-set by: npm run apk:upload (in installment-customer project)
EXPO_PUBLIC_APK_URL=https://your-project.supabase.co/storage/v1/object/public/apks/installment-customer.apk
# SHA-256 signature checksum (auto-calculated by apk:upload script)
EXPO_PUBLIC_APK_CHECKSUM=REPLACE_AFTER_RUNNING_apk_upload
