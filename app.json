{
  "expo": {
    "name": "Device Guard",
    "slug": "TestingInstallment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/DG.png",
    "scheme": "testinginstallment",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/DG.png",
      "bundleIdentifier": "com.anonymous.TestingInstallment"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/DG.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TestingInstallment"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
